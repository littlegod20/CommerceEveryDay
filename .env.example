# --- Database (Neon Postgres) ---
# Local dev: docker compose up -d, then use the value below.
# Production: paste your Neon *pooled* connection string (ends in "-pooler"),
# and keep `sslmode=require`.
DATABASE_URL="postgresql://commerce:commerce@localhost:5433/commerce_everyday"

# --- Auth.js (customer login) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# --- Admin panel ---
ADMIN_USERNAME="admin"
# bcrypt hash of the admin password — never store the plain password.
# Generate with: node scripts/hash-password.mjs "your-password-here"
# IMPORTANT: Next.js expands $VAR references in .env files, and bcrypt
# hashes are full of "$" — escape every "$" as "\$" or the hash gets
# silently mangled (this bit us once; see the value shape below).
ADMIN_PASSWORD_HASH="\$2b\$12\$replace-with-a-bcrypt-hash"
# Random secret used to sign the admin session cookie.
ADMIN_SESSION_SECRET="replace-with-a-random-32-byte-secret"

# --- Paystack (test mode) ---
# From your Paystack dashboard: Settings > API Keys & Webhooks (test mode).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_replace_me"
PAYSTACK_SECRET_KEY="sk_test_replace_me"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
